{
  "name": "landingw-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "studies": "node scripts/generate-studies.mjs",
    "photos:sample": "tsx scripts/photo-sample.ts",
    "photos:process": "tsx scripts/process-photos.ts",
    "photos:dev": "wrangler dev --config workers/photos/wrangler.jsonc",
    "photos:deploy": "wrangler deploy --config workers/photos/wrangler.jsonc",
    "photos:configure": "node scripts/configure-photos.mjs",
    "format": "prettier --write src tests scripts/serve.mjs README.md docs .github/workflows"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "aws4fetch": "^1.0.20",
    "d3-geo": "^3.1.1",
    "exifr": "^7.1.3",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.14",
    "next": "^16.3.8",
    "openseadragon": "^6.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.7",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/he": "^1.2.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/openseadragon": "^5.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "libsodium-wrappers": "^0.8.4",
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
